  {
    "id": "lUndoBag",
    "name": "lUndoBag",
    "split": "dev",
    "prompt": "Write a function named lUndoBag that takes operations [kind,value], where kind is add, remove, or undo (value ignored for undo). Add appends value; remove removes only its last occurrence if present. Undo reverses the last non-undo operation, including a no-op removal, and discards that history entry. Undo on empty history does nothing. Return the final bag in order.",
    "tests": [
      {
        "args": [
          [
            [
              "add",
              1
            ],
            [
              "remove",
              9
            ],
            [
              "undo",
              0
            ]
          ]
        ],
        "expected": [
          1
        ]
      },
      {
        "args": [
          [
            [
              "add",
              1
            ],
            [
              "add",
              2
            ],
            [
              "remove",
              1
            ],
            [
              "undo",
              0
            ]
          ]
        ],
        "expected": [
          1,
          2
        ]
      },
      {
        "args": [
          [
            [
              "add",
              4
            ],
            [
              "undo",
              0
            ],
            [
              "undo",
              0
            ]
          ]
        ],
        "expected": []
      },
      {
        "args": [
          [
            [
              "add",
              1
            ],
            [
              "add",
              2
            ],
            [
              "add",
              1
            ],
            [
              "remove",
              1
            ]
          ]
        ],
        "expected": [
          1,
          2
        ]
      }
    ]
  },
