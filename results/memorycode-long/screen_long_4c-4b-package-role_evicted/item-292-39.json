     "text": "```python\nimport numpy as np\nfrom sklearn.decomposition import PCA\n\nclass PCAAnalyzer:\n    \"\"\"\n    A class to perform Principal Component Analysis (PCA) on a dataset.\n    This class follows the coding standards and conventions established by Fortuna.\n    All method names end with '_md', attribute names start with 's_' and end with '_at',\n    and variable names start with 'x_'.\n    \"\"\"\n\n    def __init__(self, data):\n        \"\"\"\n        Initialize the PCAAnalyzer with the input data.\n        \n        Parameters:\n        data (np.ndarray): The input dataset, where each row is a sample and each column is a feature.\n        \"\"\"\n        self.s_data = data\n        self.s_mean = np.mean(data, axis=0)\n        self.s_std = np.std(data, axis=0)\n        self.s_cov = np.cov(data, rowvar=False)\n        self.s_eigenvalues = None\n        self.s_eigenvectors = None\n        self.s_components = None\n        self.s_transformed_data = None\n\n    def _md_compute_eigenvalues_eigenvectors(self):\n        \"\"\"\n        Compute the eigenvalues and eigenvectors of the covariance matrix.\n        \"\"\"\n        self.s_eigenvalues, self.s_eigenvectors = np.linalg.eig(self.s_cov)\n\n    def _md_sort_eigenvalues(self):\n        \"\"\"\n        Sort the eigenvalues and corresponding eigenvectors in descending order.\n        \"\"\"\n        sorted_indices = np.argsort(self.s_eigenvalues)[::-1]\n        self.s_eigenvalues = self.s_eigenvalues[sorted_indices]\n        self.s_eigenvectors = self.s_eigenvectors[:, sorted_indices]\n\n    def _md_select_components(self, n_components):\n        \"\"\"\n        Select the top n_components eigenvectors as the principal components.\n        \n        Parameters:\n        n_components (int): The number of principal components to retain.\n        \"\"\"\n        self.s_components = self.s_eigenvectors[:, :n_components]\n\n    def _md_transform_data(self):\n        \"\"\"\n        Transform the original data into the new coordinate system defined by the principal components.\n        \"\"\"\n        self.s_transformed_data = (self.s_data - self.s_mean) @ self.s_components\n\n    def _md_compute_explained_variance_ratio(self):\n        \"\"\"\n        Compute the proportion of variance explained by each principal component.\n        \"\"\"\n        self.s_explained_variance_ratio = self.s_eigenvalues / np.sum(self.s_eigenvalues)\n\n    def",
