     "text": "```python\nfrom typing import Optional, List, Dict, Any\n\nclass Inventory:\n    \"\"\"\n    A class to manage inventory items, including adding and removing stock.\n    This class follows PACE's coding conventions and best practices.\n    \"\"\"\n\n    def __init__(self):\n        \"\"\"\n        Initializes an empty inventory dictionary to store items and their stock.\n        \"\"\"\n        self._stock: Dict[str, int] = {}\n\n    def add_stock(self, item: str, quantity: int) -> None:\n        \"\"\"\n        Adds a specified quantity of an item to the inventory.\n\n        Args:\n            item (str): The name of the item to add stock for.\n            quantity (int): The number of units to add.\n\n        Raises:\n            ValueError: If the quantity is negative or zero.\n        \"\"\"\n        if quantity < 0:\n            raise ValueError(\"Quantity must be a positive integer.\")\n        self._stock[item] = self._stock.get(item, 0) + quantity\n\n    def remove_stock(self, item: str, quantity: int) -> None:\n        \"\"\"\n        Removes a specified quantity of an item from the inventory.\n\n        Args:\n            item (str): The name of the item to remove stock for.\n            quantity (int): The number of units to remove.\n\n        Raises:\n            ValueError: If the quantity is negative or zero.\n            ValueError: If the item is not in the inventory or does not have enough stock.\n        \"\"\"\n        if quantity < 0:\n            raise ValueError(\"Quantity must be a positive integer.\")\n        if item not in self._stock or self._stock[item] < quantity:\n            raise ValueError(f\"Insufficient stock for item '{item}'.\")\n        self._stock[item] -= quantity\n        if self._stock[item] == 0:\n            del self._stock[item]\n\n    def get_stock(self, item: str) -> Optional[int]:\n        \"\"\"\n        Retrieves the current stock level for a given item.\n\n        Args:\n            item (str): The name of the item to check.\n\n        Returns:\n            Optional[int]: The current stock level, or None if the item is not in the inventory.\n        \"\"\"\n        return self._stock.get(item)\n\n    def get_all_stock(self) -> Dict[str, int]:\n        \"\"\"\n        Returns a dictionary of all items in the inventory and their stock levels.\n\n        Returns:\n            Dict[str, int]: A dictionary where keys are item names and values are stock levels.\n        \"\"\"\n        return self._stock\n\n    def __str__(self)",
