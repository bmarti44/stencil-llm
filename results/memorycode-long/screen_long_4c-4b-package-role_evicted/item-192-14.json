elf.root = self._delete_recursive(self.root, value)\n\n    def _delete_recursive(self, node: Optional[Node], value: Any) -> Optional[Node]:\n        \"\"\"\n        Helper method to delete a node recursively from the binary tree.\n        \"\"\"\n        if node is None:\n            return None\n\n        if value < node.value:\n            node.left = self._delete_recursive(node.left, value)\n        elif value > node.value:\n            node.right = self._delete_recursive(node.right, value)\n        else:\n            # Node with only one child or no children\n            if node.left is None:\n                return node.right\n            elif",
