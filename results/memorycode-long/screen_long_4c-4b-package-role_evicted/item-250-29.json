ursive(node.left, value)\n        elif value > node.value:\n            node.right = self._f_delete_recursive(node.right, value)\n        else:\n            # Node with only one child or no child\n            if node.left is None:\n                return node.right\n            elif node.right is None:\n                return node.left\n            else:\n                # Node with two children: Get the inorder successor (smallest in the right subtree)\n                node.value = self._f_get_min_value(node.right)\n                node.right = self._f_delete_recursive(node.right, node.value)\n\n        return node\n\n    def",
