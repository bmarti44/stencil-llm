     "text": "```python\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.base import BaseEstimator, ClassifierMixin\nimport numpy as np\n\nclass NearestNeighborsClassifier(BaseEstimator, ClassifierMixin):\n    \"\"\"\n    A Nearest Neighbors classifier that follows the latest coding standards\n    and guidelines provided by Carlos, including consistent naming conventions\n    and adherence to Python best practices.\n    \"\"\"\n\n    def __init__(self, n_neighbors=5, metric='euclidean', weights='uniform'):\n        \"\"\"\n        Initialize the Nearest Neighbors classifier.\n\n        Parameters:\n        n_neighbors : int, optional\n            Number of neighbors to consider. Default is 5.\n        metric : str, optional\n            Metric to use for distance calculation. Default is 'euclidean'.\n        weights : str, optional\n            Weight function used in prediction. Default is 'uniform'.\n        \"\"\"\n        self.n_neighbors = n_neighbors\n        self.metric = metric\n        self.weights = weights\n        self._X = None\n        self._y = None\n\n    def fit(self, X, y):\n        \"\"\"\n        Fit the classifier to the training data.\n\n        Parameters:\n        X : array-like, shape (n_samples, n_features)\n            Training data.\n        y : array-like, shape (n_samples,)\n            Target values.\n\n        Returns:\n        self : object\n            Fitted estimator.\n        \"\"\"\n        self._X = X\n        self._y = y\n        return self\n\n    def predict(self, X):\n        \"\"\"\n        Predict the class labels for the provided data.\n\n        Parameters:\n        X : array-like, shape (n_samples, n_features)\n            Input data to predict.\n\n        Returns:\n        y : array-like, shape (n_samples,)\n            Predicted target values.\n        \"\"\"\n        distances = np.linalg.norm(X[:, np.newaxis] - self._X, axis=2)\n        nearest_indices = np.argsort(distances, axis=1)[:, :self.n_neighbors]\n        nearest_labels = self._y[nearest_indices]\n        \n        if self.weights == 'uniform':\n            predictions = np.apply_along_axis(lambda x: np.bincount(x).argmax(), axis=1, arr=nearest_labels)\n        elif self.weights == 'distance':\n            weights = 1.0 / distances[nearest_indices]\n            weighted_sum = np.apply_along_axis(lambda x: np.dot(x, weights), axis=1, arr=nearest_labels)\n            predictions = np.apply_along_axis(lambda x: x[np.argmax(x)],",
