ces(sample)\n            nearest_indices = np.argsort(distances)[:self.n_neighbors]\n            nearest_labels = self._labels[nearest_indices]\n            most_common = self._most_common(nearest_labels)\n            predictions.append(most_common)\n        return predictions\n\n    def _compute_distances(self, sample: Union[List[float], np.ndarray]) -> np.ndarray:\n        \"\"\"\n        Compute the Euclidean distances between the sample and all training samples.\n\n        Parameters:\n        sample (Union[List[float], np.ndarray]): The sample to compute",
