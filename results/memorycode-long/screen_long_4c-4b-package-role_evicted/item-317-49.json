[int]: Indices of the nearest neighbors in the training set.\n        \"\"\"\n        distances = [self._euclidean_distance(X, x) for x in self.X_train]\n        sorted_indices = np.argsort(distances)\n        return sorted_indices[:self.n_neighbors]\n\n    def predict(self, X: np.ndarray) -> np.ndarray:\n        \"\"\"\n        Predict the target labels for the given samples.\n\n        Args:\n            X (np.ndarray): Samples to predict for",
