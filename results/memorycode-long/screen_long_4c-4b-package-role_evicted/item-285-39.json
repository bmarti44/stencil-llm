     "text": "```python\nfrom typing import Optional, Any\n\nclass BinaryTree:\n    \"\"\"\n    A binary tree data structure where each node has at most two children.\n    This class provides methods to insert and delete nodes, following the latest coding guidelines.\n    \"\"\"\n\n    def __init__(self, value: Any = None):\n        \"\"\"\n        Initialize a binary tree with an optional root node.\n        \"\"\"\n        self.root: Optional[Node] = None\n        if value is not None:\n            self.root = Node(value)\n\n    def insert(self, value: Any) -> None:\n        \"\"\"\n        Insert a new node with the given value into the binary tree.\n        The tree is inserted in a way that maintains the binary search tree property.\n        \"\"\"\n        if self.root is None:\n            self.root = Node(value)\n        else:\n            self._insert_recursive(self.root, value)\n\n    def _insert_recursive(self, node: Node, value: Any) -> None:\n        \"\"\"\n        Helper method to recursively insert a new node into the binary tree.\n        \"\"\"\n        if value < node.value:\n            if node.left is None:\n                node.left = Node(value)\n            else:\n                self._insert_recursive(node.left, value)\n        elif value > node.value:\n            if node.right is None:\n                node.right = Node(value)\n            else:\n                self._insert_recursive(node.right, value)\n        # If value is equal, we can choose to ignore or handle it as per requirements\n        # For this implementation, we assume values are unique.\n\n    def delete(self, value: Any) -> None:\n        \"\"\"\n        Delete a node with the given value from the binary tree.\n        This method handles all deletion cases, including when the node has 0, 1, or 2 children.\n        \"\"\"\n        self.root = self._delete_recursive(self.root, value)\n\n    def _delete_recursive(self, node: Optional[Node], value: Any) -> Optional[Node]:\n        \"\"\"\n        Helper method to recursively delete a node from the binary tree.\n        \"\"\"\n        if node is None:\n            return node\n\n        if value < node.value:\n            node.left = self._delete_recursive(node.left, value)\n        elif value > node.value:\n            node.right = self._delete_recursive(node.right, value)\n        else:\n            # Node with only one child or no child\n            if node.left is None:\n                return node.right\n            elif node.right is None:\n                return node.left\n            else:\n                # Node with two children",
