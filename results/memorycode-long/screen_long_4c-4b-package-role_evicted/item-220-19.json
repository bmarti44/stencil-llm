urn [np.sum(np.abs(np.array(x) - np.array(sample))) for sample in X]\n        else:\n            raise ValueError(f\"Unsupported metric: {metric}\")\n\n    def _get_neighbors(self, distances: List[float], y: List[Any], k: int) -> List[Any]:\n        \"\"\"\n        Get the k nearest neighbors' labels or values based on the computed distances.\n\n        Parameters:\n",
