     "text": "```python\nfrom pedantic import count_calls, trace, validate\nfrom typing import Any, Optional, TypeVar\n\nT = TypeVar('T')\n\nclass LinkedList:\n    \"\"\"A doubly linked list data structure.\n\n    Attributes:\n        head: The first node in the list.\n        tail: The last node in the list.\n    \"\"\"\n\n    def __init__(self):\n        \"\"\"Initialize an empty linked list.\"\"\"\n        self.head: Optional[Node[T]] = None\n        self.tail: Optional[Node[T]] = None\n\n    def __len__(self) -> int:\n        \"\"\"Return the number of nodes in the linked list.\n\n        Returns:\n            The length of the linked list.\n        \"\"\"\n        count = 0\n        current = self.head\n        while current is not None:\n            count += 1\n            current = current.next\n        return count\n\n    def __iter__(self) -> iter[T]:\n        \"\"\"Iterate over the elements in the linked list.\n\n        Yields:\n            The elements of the linked list in order.\n        \"\"\"\n        current = self.head\n        while current is not None:\n            yield current.data\n            current = current.next\n\n    def __str__(self) -> str:\n        \"\"\"Return a string representation of the linked list.\n\n        Returns:\n            A string representation of the linked list.\n        \"\"\"\n        elements = [str(item) for item in self]\n        return f\"LinkedList({', '.join(elements)})\"\n\n    def append(self, data: T) -> None:\n        \"\"\"Add a new node with the given data to the end of the list.\n\n        Args:\n            data: The data to be added to the list.\n        \"\"\"\n        new_node = Node(data)\n        if self.tail is None:\n            self.head = new_node\n            self.tail = new_node\n        else:\n            new_node.prev = self.tail\n            self.tail.next = new_node\n            self.tail = new_node\n\n    def prepend(self, data: T) -> None:\n        \"\"\"Add a new node with the given data to the beginning of the list.\n\n        Args:\n            data: The data to be added to the list.\n        \"\"\"\n        new_node = Node(data)\n        if self.head is None:\n            self.head = new_node\n            self.tail = new_node\n        else:\n            new_node.next = self.head\n            self.head.prev = new_node\n            self.head = new_node\n\n    def insert(self, data: T, position: int)",
