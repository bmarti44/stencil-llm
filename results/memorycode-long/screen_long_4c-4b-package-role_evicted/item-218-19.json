     "text": "```python\nfrom typing import List, Tuple, Optional\nfrom collections import deque\n\n@count_calls\nclass Graph:\n    def __init__(self, nodes: List[str], edges: List[Tuple[str, str]]) -> None:\n        self._ud_nodes = nodes\n        self._ud_edges = edges\n        self._chx_adj = self._chx_build_adjacency_list()\n\n    def _chx_build_adjacency_list(self) -> dict:\n        \"\"\"Builds an adjacency list representation of the graph.\"\"\"\n        adj = {}\n        for node in self._ud_nodes:\n            adj[node] = []\n        for u, v in self._ud_edges:\n            adj[u].append(v)\n            adj[v].append(u)\n        return adj\n\n    @count_calls\n    def _ud_bfs(self, start: str, end: str) -> Optional[List[str]]:\n        \"\"\"Performs a breadth-first search to find the shortest path from start to end.\"\"\"\n        visited = set()\n        queue = deque([(start, [start])])\n        \n        while queue:\n            current_node, path = queue.popleft()\n            if current_node == end:\n                return path\n            if current_node in visited:\n                continue\n            visited.add(current_node)\n            for neighbor in self._chx_adj[current_node]:\n                if neighbor not in visited:\n                    queue.append((neighbor, path + [neighbor]))\n        return None\n\n    def _ud_get_shortest_path(self, start: str, end: str) -> Optional[List[str]]:\n        \"\"\"Returns the shortest path from start to end using BFS.\"\"\"\n        return self._ud_bfs(start, end)\n```",
