 * (X[:, j] @ residuals) + 2 * self.alpha * np.sign(self.coef_[j])\n\n                # Update the coefficient\n                self.coef_[j] = self.coef_[j] - grad / (X[:, j].var() + 1e-6)\n\n            # Check for convergence\n            if np.abs(grad).max() < self.tolerance:\n                break\n\n        # Compute the intercept\n        self.intercept_",
