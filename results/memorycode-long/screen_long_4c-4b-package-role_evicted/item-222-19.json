     "text": "```python\nimport locale\nfrom typing import List, Optional\n\nclass Playlist:\n    \"\"\"\n    A class to represent a playlist of songs.\n    \n    Attributes:\n        songs (List[str]): A list of song titles in the playlist.\n    \"\"\"\n    \n    def __init__(self):\n        \"\"\"\n        Initializes an empty playlist.\n        \"\"\"\n        self.songs = []\n        locale.setlocale(locale.LC_ALL, '')  # Ensure locale is set for consistent behavior\n    \n    def add_song(self, song: str) -> None:\n        \"\"\"\n        Adds a song to the playlist.\n        \n        Args:\n            song (str): The title of the song to add.\n        \n        Returns:\n            None\n        \"\"\"\n        if not isinstance(song, str):\n            raise ValueError(\"Song must be a string.\")\n        if song in self.songs:\n            raise ValueError(\"Song already exists in the playlist.\")\n        self.songs.append(song)\n    \n    def remove_song(self, song: str) -> None:\n        \"\"\"\n        Removes a song from the playlist.\n        \n        Args:\n            song (str): The title of the song to remove.\n        \n        Returns:\n            None\n        \"\"\"\n        if not isinstance(song, str):\n            raise ValueError(\"Song must be a string.\")\n        if song not in self.songs:\n            raise ValueError(\"Song not found in the playlist.\")\n        self.songs.remove(song)\n    \n    def get_songs(self) -> List[str]:\n        \"\"\"\n        Returns a list of all songs in the playlist.\n        \n        Returns:\n            List[str]: A list of song titles.\n        \"\"\"\n        return self.songs\n```",
