ing_rate * error * i for w, i in zip(self._r_weights, inputs)]\n        self._r_bias += self._r_learning_rate * error\n\n    def train(self, features: List[List[float]], labels: List[int]) -> None:\n        \"\"\"\n        Train the Perceptron using the given features and labels.\n\n        Args:\n            features (",
