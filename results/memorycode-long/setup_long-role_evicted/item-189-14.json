     "text": "Certainly! Below is a well-structured `Graph` class that follows the latest coding guidelines provided by your mentor, including the new naming conventions and coding standards:\n\n---\n\n### **Graph Class**\n\n```python\nfrom typing import Dict, List, Optional, Set\nfrom collections import defaultdict, deque\n\nclass Graph:\n    def __init__(self, nodes: Optional[List[str]] = None):\n        \"\"\"\n        Initialize a graph with a set of nodes and an adjacency list.\n        \n        Args:\n            nodes: A list of node names. If None, nodes are initialized as empty.\n        \"\"\"\n        self.nodes: Set[str] = set(nodes) if nodes else set()\n        self.adjacency_list: Dict[str, List[str]] = defaultdict(list)\n        self._naming_convention: str = \"g\"  # Naming convention for function arguments and methods\n\n    def add_edge(self, u: str, v: str, weight: int = 1):\n        \"\"\"\n        Add an edge between nodes u and v with the given weight.\n        \n        Args:\n            u: The starting node.\n            v: The ending node.\n            weight: The weight of the edge (default is 1).\n        \"\"\"\n        if u not in self.nodes or v not in self.nodes:\n            raise ValueError(\"Nodes must be present in the graph.\")\n        self.adjacency_list[u].append((v, weight))\n        self.adjacency_list[v].append((u, weight))\n\n    def shortest_path(self, start: str, end: str) -> Optional[List[str]]:\n        \"\"\"\n        Compute the shortest path from the start node to the end node using BFS.\n        \n        Args:\n            start: The starting node.\n            end: The target node.\n        \n        Returns:\n            A list of nodes representing the shortest path, or None if no path exists.\n        \"\"\"\n        if start not in self.nodes or end not in self.nodes:\n            return None\n\n        # BFS implementation\n        queue = deque()\n        visited = set()\n        parent = {}\n\n        queue.append((start, [start]))\n        visited.add(start)\n\n        while queue:\n            current, path = queue.popleft()\n            if current == end:\n                return path\n            for neighbor, weight in self.adjacency_list[current]:\n                if neighbor not in visited:\n                    visited.add(neighbor)\n                    parent[neighbor] = current\n                    queue.append((neighbor, path + [neighbor]))\n\n        return None\n\n    def __str__(self) -> str:\n        \"\"\"\n        Return a string",
