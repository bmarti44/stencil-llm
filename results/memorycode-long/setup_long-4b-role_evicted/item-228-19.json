     "text": "```python\nimport numpy as np\nfrom pedantic import timer_class\n\n@timer_class\nclass LinearRegression:\n    \"\"\"\n    A class for performing linear regression using numpy.\n    This class follows the coding conventions and best practices\n    established by the VERSA team, including consistent naming,\n    docstrings, and other style guidelines.\n    \"\"\"\n\n    def __init__(self, X, y):\n        \"\"\"\n        Initialize the Linear Regression model with input data.\n\n        Parameters:\n        X (np.ndarray): The input features, shape (n_samples, n_features)\n        y (np.ndarray): The target variable, shape (n_samples,)\n        \"\"\"\n        self.i_X = X  # i_ prefix for attribute name\n        self.i_y = y  # i_ prefix for attribute name\n        self.i_coefficients = None  # i_ prefix for attribute name\n        self.i_intercept = None     # i_ prefix for attribute name\n\n    def fit(self):\n        \"\"\"\n        Fit the linear regression model to the data.\n\n        This method calculates the coefficients and intercept\n        using the normal equation.\n        \"\"\"\n        # Add a column of ones to X for the intercept term\n        self.i_X = np.c_[np.ones(self.i_X.shape[0]), self.i_X]\n\n        # Calculate the coefficients using the normal equation\n        self.i_coefficients = np.linalg.inv(self.i_X.T @ self.i_X) @ self.i_X.T @ self.i_y\n\n        # Extract the intercept and coefficients\n        self.i_intercept = self.i_coefficients[0]\n        self.i_coefficients = self.i_coefficients[1:]\n\n    def predict(self, X):\n        \"\"\"\n        Predict the target values for new data.\n\n        Parameters:\n        X (np.ndarray): The input features, shape (n_samples, n_features)\n\n        Returns:\n        np.ndarray: The predicted target values, shape (n_samples,)\n        \"\"\"\n        # Add a column of ones to X for the intercept term\n        X = np.c_[np.ones(X.shape[0]), X]\n\n        # Calculate the predictions\n        return X @ self.i_coefficients\n```",
