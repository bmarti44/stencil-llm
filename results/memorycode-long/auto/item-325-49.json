   "text": "I don't want you to spend valuable time troubleshooting hook issues when you could be writing innovative code.\"",
   "key": "new:13:76",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 13,
   "span_start": 76
  },
  {
