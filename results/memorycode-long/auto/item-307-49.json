   "version": 1,
   "status": "live",
   "provenance_turn": 10,
   "span_start": 190
  },
  {
   "id": "11:0",
   "text": "Not for now.",
   "key": "new:11:0",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 11,
   "span_start": 0
  },
  {
   "id": "11:13",
   "text": "Just focus on consistent function naming and we can discuss other best practices as they become relevant to your work.",
   "key": "new:11:13",
   "scope": "MAIN",
