   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 9,
   "span_start": 127
  },
  {
   "id": "10:114",
   "text": "From now on, ensure that all your function names end with the suffix '_fn'.",
