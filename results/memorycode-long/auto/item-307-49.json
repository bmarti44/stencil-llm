  {
   "id": "9:56",
   "text": "Avoid pair programming with any of your colleagues for the time being.",
   "key": "new:9:56",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 9,
   "span_start": 56
  },
  {
   "id": "9:127",
   "text": "It's important that you develop your own problem-solving skills and coding style.",
