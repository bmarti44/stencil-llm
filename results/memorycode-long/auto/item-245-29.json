   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 8,
   "span_start": 0
  },
  {
   "id": "14:81",
   "text": "It's a powerful tool that can help streamline your development process.",
   "key": "new:14:81",
   "scope": "MAIN",
   "kind": "all",
