   "status": "live",
   "provenance_turn": 24,
   "span_start": 18
  },
  {
   "id": "24:87",
   "text": "And it's great that you're involving users in the process, as their feedback is invaluable.",
   "key": "new:24:87",
   "scope": "MAIN",
