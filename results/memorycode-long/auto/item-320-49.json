   "span_start": 11
  },
  {
   "id": "4:123",
   "text": "One of the standards we uphold in our team is the consistent use of annotations for methods.",
   "key": "new:4:123",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 4,
   "span_start": 123
  },
  {
   "id": "4:216",
   "text": "It's a simple yet effective way to enhance code readability and maintainability.",
