   "provenance_turn": 13,
   "span_start": 106
  },
  {
   "id": "14:0",
   "text": "Yes, it's always good to be prepared for potential hurdles.",
   "key": "new:14:0",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 14,
   "span_start": 0
  },
  {
   "id": "14:60",
   "text": "Anticipating issues shows that we've thoroughly tested our software.",
   "key": "new:14:60",
   "scope": "MAIN",
   "kind": "all",
   "version": 1,
   "status": "live",
   "provenance_turn": 14,
   "span_start": 60
  },
  {
   "id": "15:88",
