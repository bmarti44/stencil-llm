  {
    "path": "/private/rounds/0/negative_controls",
    "old_sha256": "b70f76d9f3d49e47be796639d65e1619b8baa9c4b73de4897454c35361ae3e49",
    "value": [
      {
        "control_id": "nc-r0-functional",
        "kind": "functional",
        "patch": "def validate_batch(batch):\n    if not isinstance(batch, list):\n        return {\"ok\": False, \"error\": \"batch must be a list\"}\n    valid = []\n    errors = []\n    index = 0\n    for element in batch:\n        result = normalize_submission(element)\n        if result[\"ok\"]:\n            valid.append(result[\"record\"])\n        else:\n            errors.append({\"index\": index, \"error\": result[\"error\"]})\n        index = index + 1\n    counts = {\"total\": len(batch), \"valid\": len(errors), \"invalid\": len(valid)}\n    return {\"ok\": True, \"valid\": valid, \"errors\": errors, \"counts\": counts}",
        "expected_failing_check_ids": [
          "chk-r0f-02",
          "chk-r0f-03",
          "chk-r0o-01",
          "chk-r0o-02"
        ]
      },
      {
        "control_id": "nc-r0-obligation",
        "kind": "obligation",
        "patch": "def validate_batch(batch):\n    if not isinstance(batch, list):\n        return {\"ok\": False, \"error\": \"batch must be a list\"}\n    valid = []\n    errors = []\n    seen = []\n    index = 0\n    for element in batch:\n        result = normalize_submission(element)\n        if result[\"ok\"]:\n            record = result[\"record\"]\n            pair = (record[\"student\"], record[\"assignment\"])\n            if pair not in seen:\n                seen.append(pair)\n                valid.append(record)\n        else:\n            errors.append({\"index\": index, \"error\": result[\"error\"]})\n        index = index + 1\n    counts = {\"total\": len(batch), \"valid\": len(valid), \"invalid\": len(errors)}\n    return {\"ok\": True, \"valid\": valid, \"errors\": errors, \"counts\": counts}",
        "expected_failing_check_ids": [
          "chk-r0o-01",
          "chk-r0o-02"
        ]
      }
    ]
  },
