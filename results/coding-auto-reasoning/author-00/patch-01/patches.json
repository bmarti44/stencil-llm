  {
    "path": "/private/rounds/2/negative_controls",
    "old_sha256": "4e75c4c896af5849b635ecf1fcb2d2a7b8ea53be0592f33bae8fd6095d19f5ba",
    "value": [
      {
        "control_id": "nc-r2-functional",
        "kind": "functional",
        "patch": "def summarize_class(batch):\n    checked = group_submissions(batch)\n    if not checked[\"ok\"]:\n        return checked\n    assignments = {}\n    total_submissions = 0\n    all_students = []\n    averages = []\n    for name in checked[\"groups\"]:\n        best = {}\n        for record in checked[\"groups\"][name]:\n            student = record[\"student\"]\n            if student not in best or record[\"score\"] > best[student]:\n                best[student] = record[\"score\"]\n        count = 0\n        group_total = 0.0\n        for student in best:\n            count = count + 1\n            group_total = group_total + best[student]\n            if student not in all_students:\n                all_students.append(student)\n        group_average = round(group_total / count, 1)\n        averages.append(group_average)\n        assignments[name] = {\"submissions\": count, \"students\": len(best), \"average\": group_average}\n        total_submissions = total_submissions + count\n    if total_submissions == 0:\n        overall_average = None\n    else:\n        overall_average = round(sum(averages) / len(averages), 1)\n    overall = {\"submissions\": total_submissions, \"students\": len(all_students), \"average\": overall_average}\n    return {\"ok\": True, \"assignments\": assignments, \"overall\": overall, \"errors\": checked[\"errors\"]}",
        "expected_failing_check_ids": [
          "chk-r2f-01",
          "chk-r2f-04",
          "chk-r2o-03"
        ]
      },
      {
        "control_id": "nc-r2-obligation",
        "kind": "obligation",
        "patch": "def summarize_class(batch):\n    checked = group_submissions(batch)\n    if not checked[\"ok\"]:\n        return checked\n    assignments = {}\n    total_submissions = 0\n    total_score = 0.0\n    all_students = []\n    for name in checked[\"groups\"]:\n        best = {}\n        for record in checked[\"groups\"][name]:\n            student = record[\"student\"]\n            if student not in best or record[\"score\"] > best[student]:\n                best[student] = record[\"score\"]\n        count = 0\n        group_total = 0.0\n        for student in best:\n            count = count + 1\n            group_total = group_total + best[student]\n            if student not in all_students:\n                all_students.append(student)\n        assignments[name] = {\"submissions\": count, \"students\": len(best), \"average\": round(group_total / count, 2)}\n        total_submissions = total_submissions + count\n        total_score = total_score + group_total\n    if total_submissions == 0:\n        overall_average = None\n    else:\n        overall_average = round(total_score / total_submissions, 2)\n    overall = {\"submissions\": total_submissions, \"students\": len(all_students), \"average\": overall_average}\n    return {\"ok\": True, \"assignments\": assignments, \"overall\": overall, \"errors\": checked[\"errors\"]}",
        "expected_failing_check_ids": [
          "chk-r2o-01",
          "chk-r2o-03"
        ]
      }
    ]
