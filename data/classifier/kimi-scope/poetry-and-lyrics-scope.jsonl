{"text": "Use British spelling throughout the poem.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped spelling convention", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Alternate between quatrains and tercets.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": true, "why": "task-scoped structural constraint", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Always capitalize the first word of each line.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "conversation-scoped formatting rule", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Make the bridge exactly four lines long.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": true, "why": "task-scoped constraint, no scope words", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Use a seasonal motif in every stanza.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped thematic constraint", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "No enjambment in this piece.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": true, "why": "task-scoped stylistic prohibition", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Keep the tone elegiac throughout.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped tonal constraint", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Include exactly three metaphors per verse.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped numerical constraint", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Write the whole ode in present tense.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped tense constraint", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Whenever you draft lyrics, avoid clichés about stars.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "conversation-scoped instruction", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
