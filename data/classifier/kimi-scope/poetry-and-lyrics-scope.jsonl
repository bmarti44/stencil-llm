{"text": "From now on, end every stanza with a question.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "conversation-scoped instruction, persists for later turns", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "Keep the villanelle under 150 words.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": true, "why": "task-scoped constraint on poem length", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
{"text": "No rhyming couplets in this sestina, please.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped constraint, no scope words", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
