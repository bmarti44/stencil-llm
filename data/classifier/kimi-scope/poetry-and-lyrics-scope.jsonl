{"text": "The title is 'Ode to a Forgotten Coat.'", "role": "user", "label": "fact", "domain": "poetry-and-lyrics", "hard": false, "why": "persistent title of work in progress", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
