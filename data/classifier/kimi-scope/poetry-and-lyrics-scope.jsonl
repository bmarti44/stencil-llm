{"text": "Use iambic pentameter for the entire sonnet.", "role": "user", "label": "rule", "domain": "poetry-and-lyrics", "hard": false, "why": "task-scoped constraint on meter", "source": "kimi-k3-scope:poetry-and-lyrics:9039"}
