{"text": "The next flu clinic is on October 3rd.", "role": "user", "label": "fact", "domain": "medical-intake-and-triage", "hard": false, "why": "durable event date", "source": "kimi-k3-scope:medical-intake-and-triage:9009"}
{"text": "Wrap every drug name in asterisks in the medication guide.", "role": "user", "label": "rule", "domain": "medical-intake-and-triage", "hard": true, "why": "task formatting constraint", "source": "kimi-k3-scope:medical-intake-and-triage:9009"}
