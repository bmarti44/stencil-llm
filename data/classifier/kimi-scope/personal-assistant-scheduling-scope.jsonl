{"text": "From now on, always confirm with me before sending any meeting invites.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "conversation-scoped standing instruction with always", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Whenever a meeting gets canceled, message the attendees right away.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "whenever makes it conversation-scoped", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Never schedule anything before 9am unless I explicitly ask.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "never creates standing rule", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Draft the reschedule email but keep it under 80 words.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "task-scoped constraint, no scope words", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the agenda in British spelling.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "task-scoped constraint on agenda", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Start the meeting notes with the date in square brackets.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "formatting constraint on notes", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "No bullet points in the follow-up email.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "task constraint without scope markers", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Use tabs in this itinerary file.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "file formatting constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "End each section of the plan with an open question.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "persistent structural constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the reminder in second person.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "style constraint on reminder", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Cite the venue's booking page in the invite.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "content constraint on invite", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Keep the subject line of the email under 12 words.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "constraint on email subject", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Begin the summary with a title in angle brackets.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "opening format constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Use lowercase only in the calendar notes.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "case constraint on notes", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Include the conference room code in every entry.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "content requirement persists", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Cap the task list at five items.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "limit constraint on task list", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the invitation as two short paragraphs.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "structure constraint on invitation", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Avoid abbreviations in the minutes.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "style constraint on minutes", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Put each attendee on its own line in the RSVP list.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "formatting constraint on list", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the out-of-office reply in French.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "language constraint on reply", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Limit the daily digest to three sentences.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "length constraint on digest", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Separate time slots with a semicolon in the spreadsheet.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "delimiter constraint on spreadsheet", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Mark urgent items with an exclamation point in the checklist.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "marking constraint on checklist", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Mention the coffee break in the agenda.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "content inclusion constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Format the phone numbers as international style in the contact sheet.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "format constraint on contact sheet", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Open the confirmation with a thank-you line.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "opening constraint on confirmation", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Keep the recap informal.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "tone constraint on recap", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Use a colon between topic and time in the schedule.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "punctuation constraint on schedule", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the apology note without exclamation marks.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "punctuation constraint on note", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Set the travel plan in 24-hour time.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "time format constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Close the briefing with a next-step section.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "ending constraint on briefing", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Stick to plain text in the reminder email.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "format constraint on reminder email", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Order the agenda items by priority.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "ordering constraint on agenda", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Actually, drop the word limit on that email.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "rule cancellation", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Change of plan — the follow-up email can use bullets after all.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "reverses prior formatting rule", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "New rule: prefix internal meetings with INT- in the calendar.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "explicit rule introduction", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Forget the lowercase thing for calendar notes.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "cancels prior case constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "From now on, BCC my manager on client scheduling emails.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "from now on makes it standing", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Keep this summary under 100 words.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": false, "why": "constraint on work is rule", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Summarize the call notes. Keep them under 120 words.", "role": "user", "label": "rule", "domain": "personal-assistant-scheduling", "hard": true, "why": "second sentence is constraint on work", "context": "user: Summarize the call notes. Keep them under 120 words.", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "My assistant ID is PA-7731.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable identifier", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The client call is at 3pm eastern on Thursday.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "meeting time and date", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "We decided to move the sprint review to Tuesdays.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "recurring decision", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The conference room code is 4490.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable access code", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "My manager's name is Dana Whitfield.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable name", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The vendor's booking reference is BK-2024-118.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable reference id", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "I'm in the office on Mondays and Wednesdays only.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "recurring availability state", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The flight lands at 6:45pm local time.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "arrival time fact", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "We use Zoom, not Teams, for external calls.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable tool preference", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The board meeting was moved to the 14th.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "rescheduled date", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "My time zone is Central European.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable timezone", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The parking spot is B-12.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "durable location id", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The quarterly review is now quarterly, not monthly.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "frequency state", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Booked — the dentist appointment is confirmed for Friday at 9.", "role": "user", "label": "fact", "domain": "personal-assistant-scheduling", "hard": false, "why": "confirmed appointment state", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write a short account of how the meeting went.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "one-off work request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Summarize the last email thread for me.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "single task request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Now add a closing section to the agenda.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "continuation is none", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Fix the next function in the scheduling script.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "one-off code fix", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Just this once, keep the reply under 100 words.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicitly single-reply constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "For this message only, reply in Spanish.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicit one-reply scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "This time, use bullets in the recap.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "this time makes it single-use", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "For this one answer, skip the greeting.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "single-reply scope stated", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Only for now, keep the list to three items.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "temporary explicit scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Make the itinerary bold just for this version.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "single-version constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Summarize this in under 90 words.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "ambiguous, treat as one-off request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Draft the cancellation notice.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "single work request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "What time is the sync tomorrow?", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "question, no persistence", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Thanks, that's perfect.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "acknowledgement", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Can you check if the room is free at noon?", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "question about availability", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Revise the opening paragraph of the invite.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "continuation request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Extend the timeline by two weeks.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "modification request on work", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Remind me what we decided about the offsite date.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "recall question", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Send the updated agenda to the team now.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "single action request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Just for this answer, use a numbered list.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicit single-reply constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "For this email only, address them formally.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicit one-off scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "This once, add a signature at the bottom.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "temporary single-use scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Keep the subject short for this message only.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "single-message constraint stated", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Only this time, capitalize the headers.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicit temporary formatting", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Write the reminder as a question just this once.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "single-instance phrasing constraint", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "For now, use 12-hour time in the schedule.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "for now limits scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "One-off: put the location in the first line.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "explicitly marked one-off", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Temporarily, bold the deadlines in the plan.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "temporary explicit scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "This reply only: no greeting at the top.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": true, "why": "single-reply scope", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Schedule a reminder for Friday morning.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "single scheduling action", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Who is attending the 2pm call?", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "attendance question", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Looks good, go ahead and send it.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "approval acknowledgement", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Add the dial-in number to the invite.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "single edit request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Now extend the summary with action items.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "continuation is none", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Tighten the second paragraph of the email.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "revision request", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Reschedule the 1:1 to next Tuesday.", "role": "user", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "one-off action", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "The next available slot is Tuesday at 11am.", "role": "assistant", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "assistant prose output", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Done — I've drafted the follow-up email below.", "role": "assistant", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "assistant confirmation prose", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
{"text": "Calendar query returned: 3 events on Thursday.", "role": "tool", "label": "none", "domain": "personal-assistant-scheduling", "hard": false, "why": "tool output is none", "source": "kimi-k3-scope:personal-assistant-scheduling:9003"}
