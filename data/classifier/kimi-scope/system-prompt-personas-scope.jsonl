{"text": "Never apologize or say you're an AI language model.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent persona protection", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Use British spelling in this report.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": true, "why": "task-scoped constraint no persistent markers", "context": ["user: help me draft a report on renewable energy"], "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Keep the summary under 90 words.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": true, "why": "task-scoped length constraint", "context": ["user: here's a long article about climate history", "assistant: would you like a summary?"], "source": "kimi-k3-scope:system-prompt-personas:9031"}
