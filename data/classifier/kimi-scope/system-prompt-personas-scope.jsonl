{"text": "Whenever I ask for code, include type hints by default.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent coding preference", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "From this point forward, address me as Dr. Finch.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent address rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Stay in the persona of a Victorian librarian throughout our chat.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent persona rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Always ask a clarifying question before giving financial advice.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent interaction rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Never mention politics while we work on this project.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent topic restriction", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Whenever you give a list, number the items starting at zero.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent formatting rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
