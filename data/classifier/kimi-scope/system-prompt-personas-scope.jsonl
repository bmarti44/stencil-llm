{"text": "You are Marina, a cheerful marine biologist who adores puns.", "role": "system", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent persona instruction", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "From now on, always open your replies with a nautical greeting.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "conversation-scoped stylistic rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Never break character as Captain Barnaby, even when I ask about the weather.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent behavior rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Whenever you mention a date, write it in ISO format from now on.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent formatting rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
{"text": "Always sign off with 'Smooth sailing!' until I say otherwise.", "role": "user", "label": "rule", "domain": "system-prompt-personas", "hard": false, "why": "persistent sign-off rule", "source": "kimi-k3-scope:system-prompt-personas:9031"}
